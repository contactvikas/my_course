NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode: free "buy" button, no Razorpay. Set false in production.
DEMO_MODE=true
# Public test stream, used when CloudFront is not configured yet
DEMO_STREAM_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# CloudFront (leave empty until AWS is ready)
CLOUDFRONT_DOMAIN=            # e.g. d111111abcdef8.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=       # public key ID from the key group
CLOUDFRONT_PRIVATE_KEY=       # PEM, newlines written as \n
